function collection(string $name): array
{
    $data = demo_data();
    return $data[$name] ?? [];
}

function find_item(string $collection, int $id): ?array
{
    foreach (collection($collection) as $item) {
        if ((int)$item['id'] === $id) {
            return $item;
        }
    }
    return null;
}

function filter_by_destination(string $collection): array
{
    $items = collection($collection);
    $destinationId = isset($_GET['destination_id']) ? (int)$_GET['destination_id'] : 0;
    if (!$destinationId) {
        return $items;
    }
    return array_values(array_filter($items, fn($item) => (int)$item['destination_id'] === $destinationId));
}

function handle_login(): void
{
    $payload = json_input();
    $email = trim($payload['email'] ?? '');
    $password = $payload['password'] ?? '';

    foreach (collection('users') as $user) {
        if ($user['email'] === $email && $user['password'] === $password) {
            unset($user['password']);
            json_response([
                'user' => $user,
                'token' => base64_encode($user['email'] . ':voyagevista-demo'),
            ]);
        }
    }

    json_response(['error' => 'Identifiants invalides'], 401);
}

function handle_register(): void
{
    $payload = json_input();
    $name = trim($payload['name'] ?? '');
    $email = trim($payload['email'] ?? '');
    $password = $payload['password'] ?? '';

    if ($name === '' || $email === '' || strlen($password) < 4) {
        json_response(['error' => 'Nom, email et mot de passe requis'], 422);
    }

    json_response([
        'id' => 99,
        'name' => $name,
        'email' => $email,
        'role' => 'client',
        'message' => 'Compte cree en simulation',
    ], 201);
}

function handle_create_reservation(): void
{
    $payload = json_input();
    $cart = $payload['cart'] ?? [];
    $total = (float)($payload['total'] ?? 0);

    if (!$cart || $total <= 0) {
        json_response(['error' => 'Panier vide ou total invalide'], 422);
    }

    json_response([
        'id' => random_int(1000, 9999),
        'status' => 'confirmee',
        'payment' => 'simule',
        'total' => $total,
        'message' => 'Reservation confirmee avec paiement simule',
        'notification' => [
            'title' => 'Reservation confirmee',
            'message' => 'Votre sejour VoyageVista a bien ete valide.',
        ],
    ], 201);
}

function handle_notifications(): void
{
    $userId = isset($_GET['user_id']) ? (int)$_GET['user_id'] : 0;
    $notifications = collection('notifications');

    if ($userId) {
        $notifications = array_values(array_filter($notifications, fn($n) => (int)$n['user_id'] === $userId));
    }

    json_response($notifications);
}

$method = $_SERVER['REQUEST_METHOD'];
$path = trim(parse_url($_SERVER['REQUEST_URI'], PHP_URL_PATH), '/');
$parts = $path === '' ? [] : explode('/', $path);

if (($parts[0] ?? '') === 'api') {
    array_shift($parts);
}

$resource = $parts[0] ?? 'health';
$id = isset($parts[1]) ? (int)$parts[1] : null;

if ($resource === 'health') {
    json_response(['app' => 'VoyageVista API', 'status' => 'ok']);
}

if ($resource === 'login' && $method === 'POST') {
    handle_login();
}

if ($resource === 'register' && $method === 'POST') {
    handle_register();
}

if ($resource === 'reservations' && $method === 'POST') {
    handle_create_reservation();
}

if ($resource === 'reservations' && $method === 'GET') {
    json_response([
        ['id' => 1, 'destination' => 'Lisbonne', 'status' => 'confirmee', 'total' => 480, 'date' => '2026-06-12'],
        ['id' => 2, 'destination' => 'Barcelone', 'status' => 'panier', 'total' => 520, 'date' => '2026-06-20'],
    ]);
}

if ($resource === 'notifications') {
    handle_notifications();
}

$collections = [
    'destinations' => 'destinations',
    'transports' => 'transports',
    'hebergements' => 'hebergements',
    'activites' => 'activites',
    'users' => 'users',
];

if (!isset($collections[$resource])) {
    json_response(['error' => 'Route inconnue', 'route' => $resource], 404);
}

if ($id) {
    $item = find_item($collections[$resource], $id);
    if (!$item) {
        json_response(['error' => 'Element introuvable'], 404);
    }
    json_response($item);
}

if (in_array($resource, ['transports', 'hebergements', 'activites'], true)) {
    json_response(filter_by_destination($collections[$resource]));
}

json_response(collection($collections[$resource]));
